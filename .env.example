# ═══════════════════════════════════════════════════════════════════
# ExamPrep Hub — environment template (copy to `.env` for local use)
# ═══════════════════════════════════════════════════════════════════
# Node 20+ recommended (`engines` in package.json).
#
# PUBLIC vs SECRET
# ────────────────
# Anything prefixed with VITE_ is embedded in the browser bundle at build
# time. Treat those values as PUBLIC. Do not put production-only secrets
# in VITE_* for multi-user deployments.
#
# AI tutor provider keys (below) are currently read by the client for
# local/dev convenience. Production should move them behind a server
# proxy (planned). Rotate any key that has shipped in a public build.
#
# Supabase anon key is designed to be public only when RLS is correct on
# every table/bucket. Authorization must not live only in React.

# ── Supabase (optional; client-visible) ───────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── AI Tutor providers (client-visible today — use with care) ─────
# Leave blank to hide that provider’s models in the picker.

# Google AI Studio — https://aistudio.google.com
VITE_GEMINI_API_KEY=

# OpenRouter — https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# Groq — https://console.groq.com/keys
VITE_GROQ_API_KEY=

# Mistral — https://console.mistral.ai/api-keys
VITE_MISTRAL_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
VITE_DEEPSEEK_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# xAI / Grok — https://console.x.ai
VITE_XAI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=
