# Supabase configuration (replace with your own values at deploy time)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI Tutor keys — each key enables one or more models in the tutor picker.
# Add only the keys for providers you want available; leave others blank.

# Gemini (free tier via Google AI Studio — https://aistudio.google.com)
VITE_GEMINI_API_KEY=

# OpenRouter (aggregator — enables GPT, Claude, DeepSeek, Gemini, and more — https://openrouter.ai/keys)
VITE_OPENROUTER_API_KEY=

# Groq (free, fast inference — https://console.groq.com/keys)
VITE_GROQ_API_KEY=

# Mistral direct API (https://console.mistral.ai/api-keys)
VITE_MISTRAL_API_KEY=

# DeepSeek direct API (https://platform.deepseek.com/api_keys)
VITE_DEEPSEEK_API_KEY=

# OpenAI direct API (https://platform.openai.com/api-keys)
VITE_OPENAI_API_KEY=

# xAI / Grok direct API (https://console.x.ai)
VITE_XAI_API_KEY=

# Anthropic direct API (https://console.anthropic.com/settings/keys)
VITE_ANTHROPIC_API_KEY=
