# Supabase configuration (replace with your own values at deploy time)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini API key for AI Tutor (free tier via Google AI Studio — https://aistudio.google.com)
VITE_GEMINI_API_KEY=

# OpenRouter API key (optional — enables GPT-4o, Claude, DeepSeek, Mistral, and more — https://openrouter.ai/keys)
VITE_OPENROUTER_API_KEY=

# Groq API key (free, fast inference — https://console.groq.com/keys)
VITE_GROQ_API_KEY=
