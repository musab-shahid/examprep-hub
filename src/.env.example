# Supabase configuration (replace with your own values at deploy time)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini API key for AI Tutor (bundled into the build — works offline from any hosting)
VITE_GEMINI_API_KEY=
# OpenRouter API key (optional — enables GPT-4o, Claude, Llama, DeepSeek, Mistral, and more)
VITE_OPENROUTER_API_KEY=